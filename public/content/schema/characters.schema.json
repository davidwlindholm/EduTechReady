{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "characters.schema.json",
  "title": "characters.json: the player and the characters",
  "description": "The player's look and the characters in the lounge and the hallway. Unique ids, tiles, models and look-alikes are checked by scripts/validate_content.mjs.",
  "type": "object",
  "required": ["player", "characters"],
  "additionalProperties": false,
  "properties": {
    "player": {
      "type": "object",
      "required": ["model", "materialColors"],
      "additionalProperties": false,
      "properties": {
        "model": { "$ref": "#/$defs/assetId" },
        "materialColors": { "$ref": "#/$defs/materialColors" }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/character" }
    }
  },
  "$defs": {
    "assetId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "materialColors": {
      "description": "Material name (see docs/ASSETS.md) to a #rrggbb colour.",
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
    },
    "character": {
      "type": "object",
      "required": ["id", "name", "model", "materialColors", "col", "row", "facing", "pose", "portrait", "summary", "greeting", "maxQuestions", "questions"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text", "description": "Name and role together, e.g. \"Mette (Underviser)\"." },
        "model": { "$ref": "#/$defs/assetId" },
        "materialColors": { "$ref": "#/$defs/materialColors" },
        "col": { "type": "integer", "minimum": 0 },
        "row": { "type": "integer", "minimum": 0 },
        "facing": { "enum": ["N", "E", "S", "W"] },
        "pose": { "enum": ["stand", "sit"] },
        "portrait": { "type": "string", "pattern": "^assets/portraits/[a-z0-9_-]+\\.(svg|png|webp)$" },
        "summary": { "$ref": "#/$defs/text" },
        "greeting": { "$ref": "#/$defs/text" },
        "maxQuestions": {
          "description": "null: no cap. Otherwise how many questions a pair may ask (at most the number of questions).",
          "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
        },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text", "answer"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "text": { "$ref": "#/$defs/text" },
              "answer": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    }
  }
}
